{{page-title "New band"}}

<h3 class="text-lg leading-6 font-medium text-gray-100">
  New band
</h3>

<form method="post" enctype="multipart/form-data">
  <div class="mt-6 grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
    <div class="sm:col-span-4">
      <label for="name" class="block text-sm font-medium leading-5">Name</label>
      <div class="mt-1 relative rounded-md shadow-sm">
        <input
          id="name"
          type="text"
          class="w-full text-gray-800 bg-white border rounded-md py-2 px-4"
          value={{this.name}}
          data-test-rr="new-band-name"
          {{on "input" this.updateName}}
        />
      </div>
    </div>
    <div class="sm:col-span-4">
      <label for="image" class="block text-sm font-medium text-gray-100">
        Image
      </label>
      {{#if this.imagePreviewSrc}}
        <div class="mt-1">
          <img src={{this.imagePreviewSrc}} alt="Band image preview" />
        </div>
      {{else}}
        <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-md">
          <div class="space-y-1 text-center">
            <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48" aria-hidden="true">
              <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div class="flex text-sm text-gray-300">
              <label for="file-upload" class="relative cursor-pointer rounded-md font-medium text-blue-400 hover:text-blue-300 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-purple-400">
                <span>Upload a file</span>
                <input
                  id="file-upload" name="file-upload" type="file" class="sr-only"
                  accept="image/jpeg, image/png, image/gif"
                  {{on "change" this.didUploadImage}}
                />
              </label>
              <p class="pl-1">or drag and drop</p>
            </div>
            <p class="text-xs text-gray-400">
              PNG, JPG, GIF up to 10MB
            </p>
          </div>
        </div>
      {{/if}}
    </div>
    <div class="sm:col-span-4">
      <div class="pt-5">
        <div class="flex justify-end">
          <button
            type="submit"
            class="px-4 py-2 rounded bg-purple-600 shadow-md hover:shadow-lg hover:text-white"
            data-test-rr="save-band-button"
            {{on "click" this.saveBand}}
          >
            Save
          </button>
        </div>
      </div>
    </div>
  </div>
</form>

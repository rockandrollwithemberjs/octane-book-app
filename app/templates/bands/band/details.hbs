{{page-title @model.name " details | Rock & Roll with Octane" replace=true}}

<div class="flex mb-4 justify-between">
  <h2 class="text-lg">{{@model.name}}</h2>
  <LinkTo
    class="ml-auto border-b-4 border-transparent hover:border-purple-400"
    @route="bands.edit-band"
    @model={{@model.id}}
    data-test-rr="edit-band-link"
  >
    Edit
  </LinkTo>
</div>
<div class="flex gap-4">
  {{#if @model.imageUrl}}
    <img
      class="w-full"
      src={{@model.imageUrl}}
      title={{@model.name}}
      alt={{@model.name}}
      data-test-rr="band-image"
    />
  {{/if}}
  <p>{{@model.description}}</p>
</div>
